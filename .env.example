# Copie este archivo a .env y ajuste los valores.
#   Con Docker:  docker compose lo lee solo.
#   Sin Docker:  set -a; source .env; set +a      (en cada terminal, antes de usar los comandos)
#
# Ejemplo: el servidor corre en el equipo 192.168.1.20 y los demás están en la LAN 192.168.1.0/24.

# ---------- Servidor (cryptostore-server) ----------
# IP de este equipo donde escucha: 127.0.0.1 = solo este equipo · 0.0.0.0 = toda la red · o una IP concreta
CRYPTOSTORE_HOST=0.0.0.0
CRYPTOSTORE_PORT=8000
# Carpeta de datos del servidor (sin Docker; en Docker es un volumen)
CRYPTOSTORE_DATA_DIR=./server-data

# ---------- A qué servidor se conectan los clientes (terminal y web) ----------
# La usan `cryptostore init` (si no se pasa --server) y la web al sugerirlo en "Crear cuenta".
# Puede ser cualquier servidor alcanzable: este mismo equipo, otro de la LAN o uno expuesto en otra red.
#   Mismo compose:                 http://server:8000
#   Este equipo, sin Docker:       http://127.0.0.1:8000
#   Otro equipo de la LAN:         http://192.168.1.20:8000
#   Desde Docker hacia este equipo: http://host.docker.internal:8000
CRYPTOSTORE_SERVER_URL=http://192.168.1.20:8000

# ---------- Cliente de terminal (cryptostore) ----------
# Carpeta del usuario con el que se trabaja (evita escribir --home en cada comando)
CRYPTOSTORE_HOME=./usuarios/alice
# Contraseña de la identidad para no teclearla en cada comando. Solo para demos y guiones:
# queda en texto plano en este archivo. Déjela vacía para que se pida por teclado.
CRYPTOSTORE_PASSPHRASE=

# ---------- Interfaz web (cryptostore web) ----------
# Carpeta con una subcarpeta por usuario (la misma que usa la terminal con --home usuarios/<nombre>)
CRYPTOSTORE_USERS_DIR=./usuarios
# IP de este equipo donde escucha la web y su puerto
CRYPTOSTORE_WEB_HOST=0.0.0.0
CRYPTOSTORE_WEB_PORT=8765
# Equipos que pueden usar la web: local · privadas · todas · o rangos/IPs separados por comas.
# Con Docker, las conexiones desde este mismo equipo llegan desde 172.16.0.0/12: inclúyalo si restringe.
CRYPTOSTORE_WEB_ALLOW_FROM=local,192.168.1.0/24,172.16.0.0/12
# HTTPS con certificado autofirmado (1 = sí). Recomendado siempre que la web no sea solo local.
CRYPTOSTORE_WEB_TLS=1
# IPs o nombres por los que se entra a la web, separados por comas (se incluyen en el certificado)
CRYPTOSTORE_WEB_ALLOWED_HOSTS=192.168.1.20
# Certificado propio en lugar del autofirmado (opcional)
CRYPTOSTORE_WEB_TLS_CERT=
CRYPTOSTORE_WEB_TLS_KEY=
# Minutos sin actividad antes de cerrar la sesión web
CRYPTOSTORE_WEB_IDLE_MINUTES=30
